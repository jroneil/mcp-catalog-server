# Copy to .env and replace placeholders before starting. Never commit .env.
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_local_username
POSTGRES_PASSWORD=replace_with_generated_local_password
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Slice 14 catalog assistant (local Ollama). No hosted-provider credentials are used.
# The backend runs in Docker, so it reaches host Ollama through host.docker.internal.
AI_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-coder-next:latest
AI_TIMEOUT=60s
