# Copy to .env and replace placeholders before starting. Never commit .env.
POSTGRES_DB=replace_with_database_name
POSTGRES_USER=replace_with_local_username
POSTGRES_PASSWORD=replace_with_generated_local_password
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Catalog assistant. AI_PROVIDER selects the logical provider: ollama (default) or bailian.
AI_ENABLED=true
AI_PROVIDER=ollama
AI_TIMEOUT=60s

# Local Ollama. The backend runs in Docker, so it reaches host Ollama through
# host.docker.internal. Ollama mode needs no hosted credential.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3-coder-next:latest

# Hosted provider: Bailian / Alibaba Cloud Model Studio (DashScope) via its
# OpenAI-compatible API. Set AI_PROVIDER=bailian to select it. Supply the credential
# through the environment or an external secret mechanism; never commit a real key.
BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.8-max
